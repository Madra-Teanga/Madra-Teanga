(ns gnéithe.ceachtanna.scáileáin.ceachtanna
  (:require
   ["package:flutter/material.dart" :as m]
   [cljd.flutter :as f]
   [clojure.string :as str]
   [gnéithe.ceachtanna.staid :as lessons-state]
   [gnéithe.ceachtanna.rialtóir :as lessons-ctrl]
   [téama.staid :as theme-state]
   [téama.rialtóir :as theme-ctrl]
   [gnéithe.ceachtanna.giuirléidí.pháirteanna :as widgets]))

;; App-bar action button that toggles between light and dark mode.
;; Icon switches to reflect the mode that will be activated on press.
(defn theme-toggle [mode]
  (m/IconButton
   .icon (if (= mode :solais) (m/Icon m.Icons/dark_mode) (m/Icon m.Icons/light_mode))
   .onPressed #(theme-ctrl/toggle-mode!)))

;; Renders the quiz phase of a lesson card.
;; Shows the Irish sentence at the top for reference, then delegates to the quiz widget.
(defn quiz-view [card wrong-guesses solved?]
  (f/widget
   (m/Center)
   (m/Column
    .mainAxisAlignment m/MainAxisAlignment.center
    .children [(m/Text (str/join " " (:irish card))
                       .style (m/TextStyle .fontSize 32 .color m/Colors.green .fontWeight m/FontWeight.bold))
               (m/SizedBox .height 50)
               (widgets/quiz-widget (:english card) (:options card) wrong-guesses solved?)])))

;; Renders the word-building phase of a lesson card.
;; The player types each Irish word one at a time into a hidden text field.
;; Letter boxes above the field show per-character feedback in real time.
(defn building-view [card word-idx typed-text show-hints ctrl is-match]
  (let [target-word     (get (:irish card) word-idx)
        target-literal  (get (:literals card) word-idx)
        ;; Words and literals already confirmed correct (shown as chips above).
        literals        (subvec (:literals card) 0 word-idx)
        completed-words (subvec (:irish card) 0 word-idx)]
    (f/widget
     (m/Padding .padding (m/EdgeInsets.all 16))
     (m/Column
      .mainAxisAlignment m/MainAxisAlignment.center
      .children [(widgets/built-sentence-display completed-words literals)
                 (m/SizedBox .height 60)
                 ;; Prompt showing the literal translation and hint toggle button.
                 (m/Row
                  .mainAxisAlignment m/MainAxisAlignment.center
                  .children [(m/Text (str "Type: \"" target-literal "\"")
                                     .style (m/TextStyle .fontStyle m/FontStyle.italic .fontSize 18 .color m/Colors.grey))
                             (m/SizedBox .width 10)
                             (m/IconButton
                              .icon (m/Icon (if show-hints m/Icons.lightbulb m/Icons.lightbulb_outline))
                              .color (if show-hints m/Colors.orange m/Colors.grey)
                              .onPressed #(lessons-ctrl/toggle-hint!))])
                 (m/SizedBox .height 20)
                 (m/Stack
                  .alignment m/Alignment.center
                  .children [;; Letter boxes displayed above the hidden text field.
                             (m/Row
                              .mainAxisAlignment m/MainAxisAlignment.center
                              .children (for [i (range (count target-word))]
                                          (let [char-target (str (get target-word i))
                                                char-typed  (when (< i (count typed-text)) (str (get typed-text i)))
                                                is-focused  (= i (count typed-text))
                                                status      (widgets/get-char-status char-target char-typed is-focused)]
                                            (widgets/letter-box char-target status char-typed show-hints))))
                             ;; Invisible text field that captures keyboard input.
                             ;; Opacity 0 keeps it off-screen while autofocus keeps the keyboard open.
                             (f/widget
                              (m/Opacity .opacity 0.0)
                              (m/TextField
                               .autofocus true
                               .controller ctrl
                               .textAlign m/TextAlign.center
                               .style (m/TextStyle .fontSize 40)
                               .onChanged #(lessons-ctrl/update-typed-text! %)
                               .onSubmitted (fn [_] (when is-match (lessons-ctrl/advance-word!)))))])]))))

;; The main lessons screen widget.
;; Watches both the lessons atom and the theme atom so it rebuilds on any state change.
;; Manages a TextEditingController via :managed so it is properly disposed of with the widget.
(defn lessons-screen []
  (f/widget
   :watch [lessons lessons-state/state
           theme   theme-state/staid]
   :managed [ctrl (m/TextEditingController)]

   (let [{:keys [mode sentence-idx word-idx typed-text show-hints quiz-wrong-guesses quiz-solved? deck]} lessons
         card        (get deck sentence-idx)
         themeMode   (:mode theme)
         target-word (when card (get (:irish card) word-idx))
         is-match    (= target-word typed-text)]

     ;; When the mode returns to :building after a quiz, clear the text controller
     ;; so stale input doesn't appear in the new word's letter boxes.
     (when (and (= mode :building) card (str/blank? typed-text) (not (str/blank? (.-text ctrl))))
       (.clear ctrl))

     (m/Scaffold
      .appBar (m/AppBar .title (m/Text "Madra Teanga") .actions [(theme-toggle themeMode)])
      .body
      (case mode
        ;; Show a spinner while the deck is being loaded from assets.
        (:loading nil) (f/widget (m/Center) (m/CircularProgressIndicator))
        :quiz          (quiz-view card quiz-wrong-guesses quiz-solved?)
        :building      (if (nil? card)
                         (f/widget (m/Center) (m/Text "No deck loaded."))
                         (building-view card word-idx typed-text show-hints ctrl is-match)))))))
