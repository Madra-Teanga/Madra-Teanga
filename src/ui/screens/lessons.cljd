(ns ui.screens.lessons
  (:require
   ["package:flutter/material.dart" :as m]
   [app.events :as events]
   [app.subs :as subs]
   [cljd.flutter :as f]
   [clojure.string :as str]
   [hti.re-dash :as rd]
   [theme.controller :as theme-ctrl]
   [theme.state :as theme-state]
   [ui.widgets.common :as widgets]))

(defn theme-toggle [mode]
  (m/IconButton
   .icon (if (= mode :light)
           (m/Icon m.Icons/dark_mode)
           (m/Icon m.Icons/light_mode))
   .onPressed #(theme-ctrl/toggle-mode!)))

;; The main screen for the lessons feature.
(defn lessons-screen []
  ;; f/widget macro makes it easy to create a stateful Flutter widget.
  (f/widget
   ;; :watch lets us subscribe to re-dash subscriptions.
   ;; The component will re-render whenever any of these values change.

   :watch [mode (rd/subscribe [::subs/mode])
           card (rd/subscribe [::subs/current-card])
           {:keys [word literal]} (rd/subscribe [::subs/current-target])
           typed (rd/subscribe [::subs/typed-text])
           word-idx (rd/subscribe [::subs/word-idx])
           theme-state theme-state/state
           show-hints (rd/subscribe [::subs/show-hints])
           wrong-guesses (rd/subscribe [::subs/quiz-wrong-guesses])
           solved? (rd/subscribe [::subs/quiz-solved?])]

   ;; :managed lets us create Flutter controllers that are automatically disposed.
   :managed [ctrl (m/TextEditingController)] ;; Controller for the hidden input field.

   ;; Logic to sync the text controller with the re-dash state.
   ;; If we are starting a new word (typed is empty) but the controller has old text, clear it.
   ;; This prevents "carrying over" typed text to the next word.
   (let [_ (when (and (= mode :building) card (str/blank? typed) (not (str/blank? (.-text ctrl))))
             (.-text! ctrl ""))]

     (m/Scaffold
      .appBar (m/AppBar .title (m/Text "Madra Teanga"))
      .body
      ;; Switch based on the current mode of the application.
      (case mode
        :loading (m/Center .child (m/CircularProgressIndicator))
        nil (m/Center .child (m/CircularProgressIndicator)) ;; Handle nil mode as loading

        ;; Quiz Mode: Shown after completing the sentence typing.
        :quiz
        (m/Center
         .child (m/Column
                 .mainAxisAlignment m/MainAxisAlignment.center
                 .children [(m/Text (str/join " " (:irish card))
                                    .style (m/TextStyle .fontSize 32 .color m/Colors.green .fontWeight m/FontWeight.bold))
                            (m/SizedBox .height 50)
                            ;; Use the reusable quiz widget.
                            (widgets/quiz-widget (:english card)
                                                 (:options card)
                                                 wrong-guesses
                                                 solved?)]))

        ;; Building Mode: The typing phase.
        :building
        (if (nil? card)
          (m/Center .child (m/Text "No deck loaded."))
          (let [literals (subvec (:literals card) 0 word-idx)
                completed-words (subvec (:irish card) 0 word-idx)
                target-word word
                is-match (= target-word typed)]

            (m/Padding
             .padding (m/EdgeInsets.all 16)
             .child (m/Column
                     .mainAxisAlignment m/MainAxisAlignment.center
                     .children [;; Show words already completed.
                                (widgets/built-sentence-display completed-words literals)
                                (m/SizedBox .height 60)

                                ;; Show hint/literal for current word.
                                (m/Row
                                 .mainAxisAlignment m/MainAxisAlignment.center
                                 .children [(m/Text (str "Type: \"" literal "\"")
                                                    .style (m/TextStyle .fontStyle m/FontStyle.italic .fontSize 18 .color m/Colors.grey))
                                            (m/SizedBox .width 10)
                                            (m/IconButton
                                             .icon (m/Icon (if show-hints
                                                             m/Icons.lightbulb
                                                             m/Icons.lightbulb_outline))
                                             .color (if show-hints m/Colors.orange m/Colors.grey)
                                             .onPressed #(rd/dispatch [::events/toggle-hints]))])

                                (m/SizedBox .height 20)

                                ;; The input area.
                                (m/Stack
                                 .alignment m/Alignment.center
                                 .children [;; 1. The visual boxes for letters.
                                            (m/Row
                                             .mainAxisAlignment m/MainAxisAlignment.center
                                             .children (for [i (range (count target-word))]
                                                         (let [char-target (str (get target-word i))
                                                               char-typed (when (< i (count typed)) (str (get typed i)))
                                                               is-focused (= i (count typed))
                                                               status (widgets/get-char-status char-target char-typed is-focused)]
                                                           (widgets/letter-box char-target status char-typed show-hints))))

                                            ;; 2. A hidden opacity 0 TextField to capture keyboard input.
                                            (m/Opacity
                                             .opacity 0.0
                                             .child (m/TextField
                                                     .autofocus true
                                                     .controller ctrl
                                                     .textAlign m/TextAlign.center
                                                     .style (m/TextStyle .fontSize 40)
                                                     ;; Dispatch event on every keystroke.
                                                     .onChanged (fn [val] (rd/dispatch [::events/update-typed-text val]))
                                                     ;; Dispatch advance event on enter (only if match is correct).
                                                     .onSubmitted (fn [_] (when is-match (rd/dispatch [::events/advance-word])))))])])))))))))
