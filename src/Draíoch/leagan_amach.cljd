
(ns Draíoch.leagan_amach
  (:require ["package:flutter/material.dart" :as m]))

;; --- Alignment (Ailíniú) ---
(def Lár m.MainAxisAlignment/center)
(def Tús m.MainAxisAlignment/start)
(def Deireadh m.MainAxisAlignment/end)

(def TrasLár m.CrossAxisAlignment/center)
(def TrasTús m.CrossAxisAlignment/start)
(def TrasDeireadh m.CrossAxisAlignment/end)
(def TrasSín m.CrossAxisAlignment/stretch)

(def AilíniúTimfhilleadh m/WrapAlignment)
(def AilíniúTimfhilleadh.center m.WrapAlignment/center)

(def Ailíniú m/Alignment)
(def Ailíniú.lár m.Alignment/center)

;; --- Layout Macros ---
(defmacro Colún [& {:keys [páistí príomh-ais tras-ais] :as opts}]
  `(m/Column
    ~@(when (contains? opts :páistí) ['.children páistí])
    ~@(when (contains? opts :príomh-ais) ['.mainAxisAlignment príomh-ais])
    ~@(when (contains? opts :tras-ais) ['.crossAxisAlignment tras-ais])))

(defmacro Ró [& {:keys [páistí príomh-ais tras-ais] :as opts}]
  `(m/Row
    ~@(when (contains? opts :páistí) ['.children páistí])
    ~@(when (contains? opts :príomh-ais) ['.mainAxisAlignment príomh-ais])
    ~@(when (contains? opts :tras-ais) ['.crossAxisAlignment tras-ais])))

(defmacro Timfhilleadh [& {:keys [páistí ailíniú] :as opts}]
  `(m/Wrap
    ~@(when (contains? opts :páistí) ['.children páistí])
    ~@(when (contains? opts :ailíniú) ['.alignment ailíniú])))

(defmacro Bosca [& {:keys [dath páiste stuáil corrlach ailíniú maisiú airde leithead] :as opts}]
  `(m/Container
    ~@(when (contains? opts :dath) ['.color dath])
    ~@(when (contains? opts :páiste) ['.child páiste])
    ~@(when (contains? opts :stuáil) ['.padding stuáil])
    ~@(when (contains? opts :corrlach) ['.margin corrlach])
    ~@(when (contains? opts :ailíniú) ['.alignment ailíniú])
    ~@(when (contains? opts :maisiú) ['.decoration maisiú])
    ~@(when (contains? opts :airde) ['.height airde])
    ~@(when (contains? opts :leithead) ['.width leithead])))

(defmacro BoscaMéide [& {:keys [airde leithead páiste] :as opts}]
  `(m/SizedBox
    ~@(when (contains? opts :airde) ['.height airde])
    ~@(when (contains? opts :leithead) ['.width leithead])
    ~@(when (contains? opts :páiste) ['.child páiste])))

(defmacro Lárionad [& {:keys [páiste] :as opts}]
  `(m/Center
    ~@(when (contains? opts :páiste) ['.child páiste])))

(defmacro Cruach [& {:keys [páistí ailíniú] :as opts}]
  `(m/Stack
    ~@(when (contains? opts :páistí) ['.children páistí])
    ~@(when (contains? opts :ailíniú) ['.alignment ailíniú])))

(defmacro Leathnaithe [& {:keys [páiste] :as opts}]
  `(m/Expanded
    ~@(when (contains? opts :páiste) ['.child páiste])))

;; --- Styling Helpers (EdgeInsets, BorderRadius etc.) ---
(defmacro Corrlach [& {:keys [uile] :as opts}]
  (if uile
    `(m/EdgeInsets.all ~uile)
    `(m/EdgeInsets)))

(defmacro Corrlach.uile [val]
  `(m/EdgeInsets.all ~val))

(defmacro MaisiúBosca [& {:keys [dath ga imill] :as opts}]
  `(m/BoxDecoration
    ~@(when (contains? opts :dath) ['.color dath])
    ~@(when (contains? opts :ga) ['.borderRadius ga])
    ~@(when (contains? opts :imill) ['.border imill])))

(defmacro GaRediúis [& {:keys [cruinn] :as opts}]
  (if cruinn
    `(m/BorderRadius.circular ~cruinn)
    `(m/BorderRadius.all m/Radius.zero)))

(defmacro GaRediúis.cruinn [val]
  `(m/BorderRadius.circular ~val))

(defmacro Imlíne [& {:keys [uile dath leithead] :as opts}]
  (if uile
    `(m/Border.all
      ~@(when (contains? opts :dath) ['.color dath])
      ~@(when (contains? opts :leithead) ['.width leithead]))
    `(m/Border)))

(defmacro Imlíne.uile [& {:keys [dath leithead] :as opts}]
  `(m/Border.all
    ~@(when (contains? opts :dath) ['.color dath])
    ~@(when (contains? opts :leithead) ['.width leithead])))
