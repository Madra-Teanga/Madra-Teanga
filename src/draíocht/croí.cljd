(defmacro TRANSLATE_swap_BANG [& args]
  `(swap! ~@args))

(defmacro TRANSLATE_theme_toggle [& args]
  `(theme-toggle ~@args))

(defmacro triail [& ghabháil]
  `(try ~@(map (fn [form]
                 (if (and (seq? form) (= 'ghabháil (first form)))
                   (cons 'catch (rest form))
                   form))
               ghabháil)))

(defmacro TRANSLATE_vector_QMARK [& args]
  `(vector? ~@args))

(defmacro TRANSLATE_when [& args]
  `(when ~@args))

(defmacro TRANSLATE_when_not [& args]
  `(when-not ~@args))
