(ns routing.routes
  (:require
   [features.lessons.ui.screens.lessons-screen :as lessons]))

;; Maps route keywords to their corresponding screen constructor functions.
;; To add a new screen:
;;   1. Require its namespace here.
;;   2. Add an entry: :route/my-screen my-ns/my-screen-fn
;; The root widget calls the function for the current route to build the active screen.
(def route-map
  {:route/home lessons/lessons-screen})
