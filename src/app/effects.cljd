(ns app.effects
  (:require ["package:audioplayers/audioplayers.dart" :as audio]
            ["package:flutter/services.dart" :as services]
            ["dart:convert" :as convert]
            [hti.re-dash :as rd]
            [app.db :as db])) ;; We dispatch to :madra.app.events/set-deck dynamically

;; 1. AUDIO UTILS
;; A simple helper function to play an audio file from the assets.
(defn play-audio! [asset-path]
  ;; Create a new AudioPlayer instance and immediately play the source.
  (doto (audio/AudioPlayer)
    (.play (audio/AssetSource asset-path))))

(defn register-effects! []
  ;; Effect: Load the deck JSON file.
  ;; This involves an asynchronous operation (reading a file), so it's a side effect.
  (rd/reg-fx
   ::fetch-deck
   (fn [_]
     (-> services/rootBundle
         (.loadString "assets/deck.json")
         ;; When the future completes (promise resolves)...
         (.then (fn [json-str]
                  (let [raw-data (convert/jsonDecode json-str)
                        ;; Convert Dart types to Clojure types.
                        clj-data (db/deep-convert raw-data)]
                    ;; Dispatch an event to update the DB with the loaded data.
                    ;; We use the fully qualified keyword to avoid circular dependency with events ns.
                    (rd/dispatch [:app.events/set-deck clj-data]))))
         ;; Handle any errors during loading.
         (.catchError (fn [err]
                        (println "Error loading deck:" err))))))

  ;; Effect: Play an audio file.
  ;; This is cleaner than calling the function directly in an event handler because
  ;; it keeps the event handler 'pure' (returning data descriptions of side effects).
  (rd/reg-fx
   ::play-audio-fx
   (fn [asset-path]
     (play-audio! asset-path))))
