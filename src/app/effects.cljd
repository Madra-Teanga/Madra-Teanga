(ns app.effects
  (:require             ["package:flutter/services.dart" :as services]
                        ["dart:convert" :as convert]
                        [hti.re-dash :as rd]
                        [app.db :as db])) ;; We dispatch to :madra.app.events/set-deck dynamically

(defn register-effects! []
  ;; Effect: Load the deck JSON file.
  ;; This involves an asynchronous operation (reading a file), so it's a side effect.
  (rd/reg-fx
   ::fetch-deck
   (fn [_]
     (-> services/rootBundle
         (.loadString "assets/deck.json")
         ;; When the future completes (promise resolves)...
         (.then (fn [json-str]
                  (let [raw-data (convert/jsonDecode json-str)
                        ;; Convert Dart types to Clojure types.
                        clj-data (db/deep-convert raw-data)]
                    ;; Dispatch an event to update the DB with the loaded data.
                    ;; We use the fully qualified keyword to avoid circular dependency with events ns.
                    (rd/dispatch [:app.events/set-deck clj-data]))))
         ;; Handle any errors during loading.
         (.catchError (fn [err]
                        (println "Error loading deck:" err)))))))


