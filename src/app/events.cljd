(ns app.events
  (:require [hti.re-dash :as rd]
            [app.db :as db]))

;; Helper function to register all events with re-dash.
(defn register-events! []

  ;; Event: Initialize the database.
  ;; Usage: (rd/dispatch [::init])
  ;; Result: Resets the app db to `initial-db`.
  (rd/reg-event-db
   ::init
   (fn [_ _]
     db/initial-db))

  ;; Event: Trigger the loading of the deck.
  ;; Usage: (rd/dispatch [::load-deck])
  ;; Result: Triggers a side-effect (fx) to fetch the deck file.
  ;; reg-event-fx allows us to return a map of effects instead of just a new db state.
  (rd/reg-event-fx
   ::load-deck
   (fn [_ _]
     ;; call the :madra.app.effects/fetch-deck effect with nil as argument
     {:app.effects/fetch-deck nil}))

  ;; Event: Set the deck data in the database.
  ;; Usage: (rd/dispatch [::set-deck received-deck-data])
  (rd/reg-event-db
   ::set-deck
   (fn [db [_ deck]]
     ;; Update the database with the new deck and reset indices and mode.
     (assoc db :deck deck :mode :building :sentence-idx 0 :word-idx 0)))

  ;; Event: Advance to the next word in the sentence.
  ;; Usage: (rd/dispatch [::advance-word])
  ;; Logic: Checks if there are more words. If yes, increments word-idx.
  ;;        If no (sentence done), switches mode to :quiz and plays audio.
  (rd/reg-event-fx
   ::advance-word
   (fn [{:keys [db]} _]
     (let [card (get (:deck db) (:sentence-idx db))
           total-words (count (:irish card))
           current-idx (:word-idx db)]
       (if (< (inc current-idx) total-words)
         ;; Case: More words remain. Update DB.
         {:db (assoc db :word-idx (inc current-idx) :typed-text "")}
         ;; Case: Sentence finished. Switch to quiz mode and trigger audio effect.
         {:db (assoc db :mode :quiz :typed-text "")
          :app.effects/play-audio-fx (:audio-asset card)}))))

  ;; Event: Move to the next sentence (card) in the deck.
  ;; Usage: (rd/dispatch [::next-sentence])
  (rd/reg-event-db
   ::next-sentence
   (fn [db _]
     ;; Use `merge` to overwrite multiple keys in the db map.
     ;; `mod` ensures we loop back to the start if we reach the end of the deck.
     (merge db {:sentence-idx (mod (inc (:sentence-idx db)) (count (:deck db)))
                :word-idx 0
                :typed-text ""
                :mode :building
                :show-hints false
                :quiz-wrong-guesses #{}
                :quiz-solved? false})))

  ;; Event: Toggle the hint display.
  ;; Usage: (rd/dispatch [::toggle-hints])
  (rd/reg-event-db
   ::toggle-hints
   (fn [db _]
     (update db :show-hints not)))

  ;; Event: Update the text currently typed by the user.
  ;; Usage: (rd/dispatch [::update-typed-text "some text"])
  (rd/reg-event-db
   ::update-typed-text
   (fn [db [_ text]]
     (assoc db :typed-text text)))

  ;; Event: Handle a guess in the quiz mode.
  ;; Usage: (rd/dispatch [::quiz-guess "selected option"])
  (rd/reg-event-fx
   ::quiz-guess
   (fn [{:keys [db]} [_ opt]]
     (let [card (get (:deck db) (:sentence-idx db))
           correct-answer (:english card)
           is-correct (= opt correct-answer)]
       (if is-correct
         ;; Case: Correct guess. Mark solved and schedule next sentence after delay.
         {:db (assoc db :quiz-solved? true)
          :dispatch-later {:ms 1000 :dispatch [::next-sentence]}}
         ;; Case: Wrong guess. Add to the set of wrong guesses (UI can show red).
         {:db (update db :quiz-wrong-guesses conj opt)})))))
