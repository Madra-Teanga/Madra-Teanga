(ns app.db
  ;; Import Dart's core library dealing with basic types like Map and List.
  )

;; The initial state of our application database.
;; This is a standard Clojure map that holds all the data our app needs.
(def initial-db
  {:deck []                ;; Vector to hold the list of flashcards loaded from JSON.
   :sentence-idx 0         ;; Integer tracking which sentence (card) we are currently on.
   :word-idx 0             ;; Integer tracking which word in the sentence we are currently on.
   :typed-text ""          ;; String holding what the user has currently typed.
   :mode :loading          ;; Keyword representing the current state of the game: :loading, :building (typing), or :quiz.
   :show-hints false       ;; Boolean to toggle whether hints are shown to the user.
   :quiz-wrong-guesses #{} ;; Set to store wrong answers selected during the quiz phase (sets ensure uniqueness).
   :quiz-solved? false})   ;; Boolean to track if the current quiz question has been correctly answered.

;; A helper function to deeply convert Dart structures (Lists, Maps) into Clojure structures (Vectors, Maps).
;; When we load JSON from Flutter, it comes back as Dart objects. We prefer working with Clojure data.
(defn deep-convert [x]
  (cond
    ;; If it's already a Clojure vector, recursively convert its contents.
    (vector? x) (mapv deep-convert x)

    ;; If it's a Dart Map, convert it to a Clojure map and recursively convert keys and values.
    ;; keywords are used for keys.
    (instance? dart:core/Map x) (into {} (map (fn [[k v]] [(keyword k) (deep-convert v)]) x))

    ;; If it's a Dart List, convert it to a Clojure vector (mapv returns a vector).
    (instance? dart:core/List x) (mapv deep-convert x)

    ;; If it's any other sequential collection, convert strictly to a vector.
    (sequential? x) (mapv deep-convert x)

    ;; Otherwise, return the value as is (e.g., strings, numbers).
    :else x))
