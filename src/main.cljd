(ns main
  (:require
   ["package:flutter/material.dart" :as m]
   [features.lessons.controller :as lessons-ctrl]
   [routing.root :as router]
   [theme.controller :as theme]))

;; The main entry point of the application.
;; Initialises all subsystems in order, then hands control to Flutter.
(defn main []
  ;; Required before any Flutter APIs are called.
  (m/WidgetsFlutterBinding.ensureInitialized)

  ;; Load the persisted theme mode (light/dark) from local storage.
  ;; Also wires up a watcher that saves any future mode changes automatically.
  (theme/load-mode!)

  ;; Reset the lessons atom to its initial state, then load deck.json from assets.
  (lessons-ctrl/init!)
  (lessons-ctrl/load-deck!)

  ;; Launch the Flutter widget tree. The root widget observes routing and theme atoms.
  (m/runApp
   (router/view)))
