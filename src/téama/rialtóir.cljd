(ns téama.inchinn
  (:require [téama.staid :as s]
            [téama.comharthaí :as t]
            [sheirbhísí.stórais_logánta :as local_store]
            ["package:flutter/material.dart" :as m]))

;; Builds a Flutter ThemeData map for the given mode keyword (:light or :dark).
;; Called by the root widget on every rebuild to apply the current theme.
(defn mode-setting [mode]
  (let [light? (= mode :light)]
    (m/ThemeData
     .brightness (if light? m.Brightness/light m.Brightness/dark)
     .primaryColor (if light?
                     (:brand-primary t/colors)
                     (:brand-secondary t/colors))
     .appBarTheme (m/AppBarTheme
                   .backgroundColor (if light?
                                      (:brand-primary t/colors)
                                      (:surface-dark t/colors))
                   .foregroundColor m.Colors/white))))

;; Toggles the active mode between :light and :dark.
;; The state watcher installed by load-mode! will persist the change automatically.
(defn toggle-mode! []
  (swap! s/state update :mode {:light :dark :dark :light}))

;; Loads the persisted theme mode from local storage on app startup.
;; Falls back to :light if nothing is stored or an error occurs.
;; Also installs a watcher that persists any future mode changes to storage
;; so the preference survives app restarts.
(defn ^:async load-mode! []
  (try
    (let [mode-str (await (local_store/get-value "theme_mode"))
          mode (if mode-str (keyword mode-str) :light)]
      (swap! s/state assoc :mode mode))
    (catch Object _
      (swap! s/state assoc :mode :light)))
  (add-watch s/state :persist
             (fn [_ _ _ new-state]
               (local_store/set-value! "theme_mode" (name (:mode new-state))))))
